# ============ 工作区公共环境变量 ============
# 复制为 .env 后按实际环境修改，各子项目可再覆盖

# ----- Dify -----
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=

# ----- ERPNext + cos -----
COS_ERP_BASE=https://your-erpnext-host
COS_API_KEY=
COS_API_SECRET=

# ----- 中间层 (middleware) -----
PORT=3000

# ----- 前端 (frontend) 开发代理目标 -----
NUXT_PUBLIC_API_BASE=http://localhost:3000
