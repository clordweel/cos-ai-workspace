# ============ 工作区公共环境变量 ============
# 复制为 .env 后按实际环境修改，各子项目可再覆盖

# ----- 聊天后端（适配器） -----
# mock（默认，功能调试）| dify | zulip | matrix。决定 GET /api/sessions、流式发送等使用的后端
# CHAT_PROVIDER=mock

# ----- Matrix（CHAT_PROVIDER=matrix 时必填） -----
# 与 deploy/matrix 部署的 Synapse 对接，见 docs/SESSION_ADAPTER_MATRIX.md
# MATRIX_BASE_URL=http://10.1.1.15:8008
# 二选一：直接填 access token，或填 userId + password（中间层会登录并缓存 token）
# MATRIX_USER_ID=@workbench:10.1.1.15
# MATRIX_PASSWORD=
# MATRIX_ACCESS_TOKEN=

# ----- Dify -----
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=

# ----- ERPNext 业务相关 (cos / Frappe API) -----
# 中间层调用 ERPNext/cos 时使用，前端不直连
COS_ERP_BASE=https://your-erpnext-host/api
COS_ERP_API_KEY=
# 若 Frappe 使用 API Key + Secret 认证，可配置 Secret（具体用法由 cos 侧约定）
COS_ERP_API_SECRET=
# 调用 ERPNext 接口超时（毫秒），可选，默认 15000
# COS_ERP_TIMEOUT_MS=15000

# ----- 中间层 (middleware) -----
PORT=3000

# ----- 前端 (frontend) 开发代理目标 -----
# 同机开发时可留空，前端将用相对路径 /api，由 Vite 代理到中间层，避免跨域与 Failed to fetch
# NUXT_PUBLIC_API_BASE=http://localhost:3000
# Logto 单点登录（可选）。发行者根地址，中间层会拼 /oidc/auth、/oidc/token、/oidc/me
# LOGTO_ENDPOINT=https://auth.junhai.work
# LOGTO_APP_ID=3nwua32rnbzzz43w2avhs
# LOGTO_APP_SECRET=<应用密钥，从 Logto 控制台复制>
# 工作台用 Logto 时：在 Logto 中配置的 Redirect URI 必须为「中间层」回调地址，例如：
#   http://10.1.1.21:3000/api/auth/logto/callback  （中间层 PORT=3000 时）
# 不要填前端或 Synapse 地址。Logto 回调到中间层后，由下面 FRONTEND_ORIGIN 决定最终跳转到前端。
# Logto 回调后跳转的前端地址（可选，默认 http://localhost:3001）
# FRONTEND_ORIGIN=http://10.1.1.21:3001