# ============ 工作区公共环境变量 ============
# 复制为 .env 后按实际环境修改，各子项目可再覆盖

# ----- 聊天后端（适配器） -----
# mock（默认，功能调试）| dify | zulip | matrix。决定 GET /api/sessions、流式发送等使用的后端
# CHAT_PROVIDER=mock

# ----- Matrix（CHAT_PROVIDER=matrix 时必填） -----
# 与 deploy/matrix 部署的 Synapse 对接，见 docs/SESSION_ADAPTER_MATRIX.md
# MATRIX_BASE_URL=http://10.1.1.15:8008
# Synapse server_name（MXID 域名），不填则用 MATRIX_BASE_URL 的 host。Logto 用户同步需此值
# MATRIX_SERVER_NAME=10.1.1.15
# 二选一：access token 或 userId+password。仅用于 Admin API（用户同步/设密），会话操作一律用当前用户 token
# MATRIX_USER_ID=@workbench:10.1.1.15
# MATRIX_PASSWORD=
# MATRIX_ACCESS_TOKEN=
# 可选：助手回复写入 Matrix 房间时使用的 bot。配置后 Dify 助手回复会以该 bot 身份发到当前房间并持久化
# MATRIX_BOT_USER_ID=@ai-assistant:10.1.1.15
# MATRIX_BOT_ACCESS_TOKEN=
# MAS Personal Session（可选，方案 A 禁用 MAS 时勿配置）：配置后中间层优先用 MAS Admin API 签发 token
# MAS_ADMIN_CLIENT_ID=
# MAS_ADMIN_CLIENT_SECRET=
# Matrix 密码持久化到 Logto（可选）：32+ 字符加密钥，配置后密码加密存 customData，需 LOGTO_M2M_*。方案 A 推荐启用
# MATRIX_PASSWORD_ENCRYPTION_KEY=

# ----- Dify -----
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=

# ----- ERPNext 业务相关 (cos / Frappe API) -----
# 中间层调用 ERPNext/cos 时使用，前端不直连
COS_ERP_BASE=https://your-erpnext-host/api
COS_ERP_API_KEY=
# 若 Frappe 使用 API Key + Secret 认证，可配置 Secret（具体用法由 cos 侧约定）
COS_ERP_API_SECRET=
# 调用 ERPNext 接口超时（毫秒），可选，默认 15000
# COS_ERP_TIMEOUT_MS=15000

# ----- 中间层 (middleware) -----
PORT=3000
# 会话存储：memory（默认）| redis。redis 时重启/多实例共享会话，见 docs/SESSION_PERSISTENCE.md
# SESSION_STORE=memory
# Redis 连接 URL，SESSION_STORE=redis 时必填（如 deploy/redis 部署后）
# REDIS_URL=redis://10.1.1.15:6379

# ----- 前端 (frontend) 开发代理目标 -----
# 同机开发时可留空，前端将用相对路径 /api，由 Vite 代理到中间层，避免跨域与 Failed to fetch
# NUXT_PUBLIC_API_BASE=http://localhost:3000
# 前端 matrix-js-sdk 使用的 Matrix homeserver（可选，与 MATRIX_BASE_URL 同源或同服务时一致）
# NUXT_PUBLIC_MATRIX_BASE_URL=http://10.1.1.15:8008
# 与 CHAT_PROVIDER 一致时关闭前端 mock 会话列表，仅展示真实会话（如 matrix 会话落地）
# NUXT_PUBLIC_CHAT_PROVIDER=matrix
# 临时样式调试：设为 true 时强制在会话列表中显示 Mock 会话区块（与 chatProvider 无关）
# NUXT_PUBLIC_DEBUG_MOCK_SESSIONS=true
# Nuxt 承载 Logto 时（推荐）：前端发起登录与回调，Redirect URI 填「前端主地址」：
#   NUXT_PUBLIC_LOGTO_ENDPOINT=https://auth.junhai.work
#   NUXT_PUBLIC_LOGTO_APP_ID=<应用 ID>
#   Logto 控制台 Redirect URIs 填： https://你的前端域名/logto-callback（如 https://yourapp.com/logto-callback、http://localhost:3001/logto-callback）
# 中间层仍负责用 code 换 token 与写 Cookie，需配置 LOGTO_* 与 LOGTO_APP_SECRET。
# ----- 中间层 Logto（code 换 token 用，含 APP_SECRET，勿放前端） -----
# 端点不含末尾斜杠；授权/Token/用户信息：{LOGTO_ENDPOINT}/oidc/auth、/oidc/token、/oidc/me
# LOGTO_ENDPOINT=https://auth.junhai.work
# LOGTO_APP_ID=<应用 ID>
# LOGTO_APP_SECRET=<应用密钥，从 Logto 控制台复制>
# 修改 Logto 密码（用户信息页）需 Management API：创建 M2M 应用并赋权，填下面两项；不填则沿用上面 APP_ID/APP_SECRET
# LOGTO_M2M_APP_ID=
# LOGTO_M2M_APP_SECRET=
# 前端 @logto/nuxt 加密 Cookie 用（必填且需与 NUXT 一致）；仅服务端读取
# NUXT_LOGTO_COOKIE_ENCRYPTION_KEY=随机字符串
# 当使用「中间层直接回调」时，Redirect URI = {中间层访问根}/api/auth/logto/callback；见下
# 若出现 oidc.invalid_redirect_uri：要么在 Logto 里添加当前实际使用的回调地址，要么设置
# MIDDLEWARE_PUBLIC_ORIGIN 固定为你在 Logto 里填的那段「中间层访问根」（不含路径），例如：
#   MIDDLEWARE_PUBLIC_ORIGIN=http://localhost:3000
#   则 Redirect URI 填： http://localhost:3000/api/auth/logto/callback
#   MIDDLEWARE_PUBLIC_ORIGIN=https://api.yourapp.com
#   则 Redirect URI 填： https://api.yourapp.com/api/auth/logto/callback
# MIDDLEWARE_PUBLIC_ORIGIN=（可选）未设时从请求的 protocol+host 推导；反向代理同域部署见 docs/REVERSE_PROXY_SINGLE_DOMAIN.md
# FRONTEND_ORIGIN=（可选）Logto 回调后 302 到前端的地址；同域代理且带 X-Forwarded-Host 时可不设，会沿用当前请求主机
# FRONTEND_ORIGIN=http://10.1.1.21:3001