{
  "name": "ai-workbench-workspace",
  "private": true,
  "description": "AI 驱动交互工作台 — 多项目根",
  "scripts": {
    "install:all": "npm install && pnpm install",
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "pnpm --filter @cosai/api run dev",
    "dev:web": "pnpm --filter @cosai/web run dev",
    "dev:web:invite": "pnpm --filter @cosai/web run dev:invite",
    "dev:matrix": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "build:api": "pnpm --filter @cosai/api run build",
    "build:web": "pnpm --filter @cosai/web run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "pnpm": "^10.0.0"
  }
}
