# Matrix Synapse 部署环境变量
# 复制为 .env 并填写实际值：cp .env.example .env

# 必填：Matrix 服务器名，将作为 MXID 的域名部分（如 @user:matrix.example.com）
# 内网可用 IP 或主机名，例如 10.1.1.15 或 matrix.internal
SYNAPSE_SERVER_NAME=10.1.1.15

# 必填：PostgreSQL 密码（请使用强密码）
POSTGRES_PASSWORD=your_secure_password

# 可选：PostgreSQL 用户与库名（默认 synapse）
POSTGRES_USER=synapse
POSTGRES_DB=synapse

# 可选：Synapse HTTP 端口（默认 8008）
SYNAPSE_HTTP_PORT=8008

# 可选：Logto OIDC 登录。三者都设置时，bootstrap 会在 homeserver.yaml 中注入 oidc_providers
# 在 Logto 控制台为 Synapse 单独建应用，Redirect URI 设为 https://<synapse-public-baseurl>/_synapse/client/oidc/callback
# LOGTO_ISSUER=https://your-logto.app
# LOGTO_APP_ID_MATRIX=
# LOGTO_APP_SECRET=

# 可选 MAS 扩展：bootstrap-mas.sh 会生成并追加以下变量；主流程以 Synapse 单机为准
# MAS_POSTGRES_PASSWORD=
# MAS_SECRET=
# MAS_ADMIN_CLIENT_ID=      # 中间层可选，见 docs/archive/mas
# MAS_ADMIN_CLIENT_SECRET=
