# CosAI 测试部署环境变量（复制为 .env 后按远端环境修改）
# 数据库/Redis 优先使用 10.1.1.15 上已有服务，通过下列变量引用

# ---------- 端口（宿主机映射）----------
WEB_PORT=3001
API_PORT=3000

# ---------- 对外访问根 URL（用远端 IP 或域名）----------
APP_ORIGIN=http://10.1.1.15:3001
API_PUBLIC_ORIGIN=http://10.1.1.15:3000
FRONTEND_ORIGIN=http://10.1.1.15:3001

# ---------- Logto ----------
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# ---------- 聊天与 Matrix（可选）----------
# 生产环境暂时使用 mock 演示数据；改为 matrix 可接入真实会话
CHAT_PROVIDER=mock
MATRIX_BASE_URL=
MATRIX_SERVER_NAME=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_PASSWORD=
MATRIX_BOT_USER_ID=
MATRIX_BOT_ACCESS_TOKEN=

# ---------- 公共依赖（优先使用远端已有服务）----------
# 若 api 使用 Redis：指向宿主机或同机已有 Redis
# REDIS_URL=redis://10.1.1.15:6379
# REDIS_URL=redis://redis:6379
# 若使用数据库：
# DATABASE_URL=postgresql://user:pass@10.1.1.15:5432/dbname
