# apps/web 前端镜像：在 monorepo 内构建，产出静态文件由 nginx 提供
# 构建时需从仓库根目录： docker build -f deploy/cosai/Dockerfile.web .

FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/ ./packages/
COPY frontend/package.json ./frontend/
COPY middleware/package.json ./middleware/
RUN mkdir -p apps/api/src apps/web/public frontend/src middleware/src

COPY apps/web ./apps/web
COPY apps/api/tsconfig.json ./apps/api/
COPY apps/api/src ./apps/api/src

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cosai/mock run build
RUN pnpm --filter @cosai/web run build

# 运行阶段：nginx 托管 dist
FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
RUN echo 'server { root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } }' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
