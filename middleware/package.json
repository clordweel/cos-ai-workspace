{
  "name": "ai-workbench-middleware",
  "version": "0.1.0",
  "description": "Fastify SSE + API orchestration for AI Workbench",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "predev": "node scripts/release-port.js",
