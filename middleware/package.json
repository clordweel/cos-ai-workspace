{
  "name": "ai-workbench-middleware",
  "version": "0.1.0",
  "description": "Fastify SSE + API orchestration for AI Workbench",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "predev": "tsx scripts/release-port.ts",
    "release-port": "tsx scripts/release-port.ts",
    "start": "node dist/src/index.js",
    "pretest": "npm run build",
    "test": "CHAT_PROVIDER=mock node --test test/adapters/mock.test.js test/adapters/getAdapter.test.js test/routes/chat.test.js",
    "dev:debug": "tsx watch --inspect src/index.ts",
    "dev:debug-brk": "tsx watch --inspect-brk src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.x",
    "@fastify/cors": "^10.x",
    "@logto/api": "^1.36.0",
    "dify-client": "^3.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.x",
    "frappe-js-sdk": "^1.12.0",
    "http-graceful-shutdown": "^3.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
