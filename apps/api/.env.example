# ============ apps/api 环境变量示例 ============
# 本包与根目录 .env 彻底隔离：仅读取本目录 .env，不读取、不依赖工作区根目录 .env。
# 运行 api 前请在本目录配置齐全所需变量（可参考根目录 .env.example 的命名，但值需填在本文件复制而成的 .env 中）。

# ----- 服务与对外地址 -----
# 服务端口（默认 3000）；middleware 对应 PORT
API_PORT=3000
# PORT=3000
# 对外访问根 URL（拼 Logto redirect_uri 等）。与 middleware 的 MIDDLEWARE_PUBLIC_ORIGIN 同义，可互用
API_PUBLIC_ORIGIN=http://10.1.1.21:3000
# MIDDLEWARE_PUBLIC_ORIGIN=  # 可选，与 API_PUBLIC_ORIGIN 二选一
# Logto 回调后 302 到前端的地址；同域代理时可不设
FRONTEND_ORIGIN=http://10.1.1.21:3001

# ----- 聊天后端（适配器，与 middleware 一致） -----
# mock（默认）| matrix。当前仅此二者已注册
CHAT_PROVIDER=mock

# ----- Matrix（CHAT_PROVIDER=matrix 时必填） -----
# 与 deploy/matrix 部署的 Synapse 对接，见 docs/SESSION_ADAPTER_MATRIX.md
# MATRIX_BASE_URL=http://10.1.1.15:8008
# 单域名/反向代理时，前端 matrix-js-sdk 用此地址；不填则用 MATRIX_BASE_URL
# MATRIX_PUBLIC_BASE_URL=https://cosai.junhai.work
# Synapse server_name（MXID 域名），不填则用 MATRIX_BASE_URL 的 host。Logto 用户同步需此值
# MATRIX_SERVER_NAME=10.1.1.15
# 二选一：access token 或 userId+password。仅用于 Admin API（用户同步/设密），会话操作用当前用户 token
# MATRIX_USER_ID=@admin:10.1.1.15
# MATRIX_PASSWORD=
# MATRIX_ACCESS_TOKEN=
# 可选：助手回复以 bot 身份写入房间。不填且 CHAT_PROVIDER=matrix + DIFY_API_KEY 已配时，API 启动会自动创建 bot 并写 token 到 data/.matrix-bot-token
# MATRIX_BOT_USER_ID=@ai-assistant:10.1.1.15
# MATRIX_BOT_ACCESS_TOKEN=
# 自动初始化用：bot 本地名（默认 ai-assistant）；若 bot 已存在且已知密码可填 MATRIX_BOT_PASSWORD，API 会登录并写入 token 文件
# MATRIX_BOT_LOCALPART=ai-assistant
# MATRIX_BOT_PASSWORD=
# Matrix 密码持久化到 Logto（可选）：32+ 字符加密钥，配置后密码加密存 customData，需 LOGTO_M2M_*
# MATRIX_PASSWORD_ENCRYPTION_KEY=

# ----- Dify（@ 助手时流式回复，与 middleware 一致） -----
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=

# ----- 会话持久化（见 docs/SESSION_PERSISTENCE.md） -----
# memory（默认，重启丢失）| file（单文件 JSON，重启保留）| redis（多实例共享）
# SESSION_STORE=memory
# SESSION_STORE=file
# SESSION_FILE_PATH=   # 默认 apps/api/data/sessions.json
# SESSION_STORE=redis
# REDIS_URL=redis://10.1.1.15:6379

# ----- Logto（code 换 token、/me、Management API，勿放前端） -----
# 端点不含末尾斜杠；若出现「拒绝连接」请确认本机可访问、服务已启动
# LOGTO_ENDPOINT=https://auth.junhai.work
# LOGTO_APP_ID=<应用 ID>
# LOGTO_APP_SECRET=<应用密钥，从 Logto 控制台复制>
# 修改 Logto 密码、用户偏好同步、用户/角色管理、GET /api/auth/me 返回角色 等需 Management API：创建 M2M 应用并赋权，填下面两项；不填则沿用上面 APP_ID/APP_SECRET。若出现 403/Forbidden，请在 Logto 控制台为该 M2M 应用分配「Management API」相关角色
# LOGTO_M2M_APP_ID=
# LOGTO_M2M_APP_SECRET=
# Logto 回调：Redirect URI = {API_PUBLIC_ORIGIN}/api/auth/logto/callback；若 oidc.invalid_redirect_uri 请在 Logto 控制台添加该地址
# 系统管理员：指定邮箱与当前登录用户 email 一致时，GET /api/auth/me 返回 isSystemAdmin: true
# SYSTEM_ADMIN_EMAIL=mahaibo@xuma.js.cn

# ----- Frappe/ERPNext（cos、Memo 等，仅 api 使用） -----
# ERPNext API Base URL，末尾不要斜杠；不配则 Memo/cos 相关路由不生效
# COS_ERP_BASE=https://erp.example.com/api
# 单 Key 试跑：所有请求用该 Key；每用户 Key 时由连接器/设置页绑定并存 ConnectorCredentialsStore
# COS_ERP_API_KEY=
# 若 ERP 使用 API Key + Secret 认证可填
# COS_ERP_API_SECRET=
# Memo 试点使用的 DocType：ToDo（默认）或自定义 Memo
# COS_ERP_MEMO_DOCTYPE=ToDo
