# ============ apps/api 环境变量示例 ============
# 与根 .env 完全隔离，仅使用本目录 .env；不读取工作区根目录 .env。
# 复制为 .env 后按实际修改；本机主机 10.1.1.21 时可直接使用下方示例。

# 服务端口（默认 3000）
API_PORT=3000
# PORT=3000

# 对外访问根 URL（拼 Logto redirect_uri 等），本机或内网访问时用本机 IP
API_PUBLIC_ORIGIN=http://10.1.1.21:3000
# MIDDLEWARE_PUBLIC_ORIGIN=  # 可选，与 API_PUBLIC_ORIGIN 二选一

# 前端根 URL（Logto 回调后重定向目标、GET /api/auth/logto/url 的 redirect_uri 前端 origin）
FRONTEND_ORIGIN=http://10.1.1.21:3001

# ----- 聊天后端（适配器） -----
# mock（默认）| matrix
CHAT_PROVIDER=mock

# ----- Matrix（CHAT_PROVIDER=matrix 时必填） -----
# 服务端请求必须用 API 能访问的地址，单域名时前端地址用 MATRIX_PUBLIC_BASE_URL 经 /me 下发
# MATRIX_BASE_URL=http://10.1.1.15:8008
# MATRIX_PUBLIC_BASE_URL=https://cosai.junhai.work
# MATRIX_SERVER_NAME=10.1.1.15
# 二选一：access token 或 userId+password
# MATRIX_USER_ID=@admin:10.1.1.15
# MATRIX_PASSWORD=
# MATRIX_ACCESS_TOKEN=
# 可选：助手回复以 bot 身份写入房间
# MATRIX_BOT_USER_ID=@ai-assistant:10.1.1.15
# MATRIX_BOT_ACCESS_TOKEN=
# Matrix 密码加密存 Logto customData（32+ 字符），需 LOGTO_M2M_*
# MATRIX_PASSWORD_ENCRYPTION_KEY=

# ----- 会话持久化（与 middleware 一致） -----
# memory（默认）：重启后会话丢失，需重新登录。redis：会话存 Redis，重启后认证保持，见 docs/SESSION_PERSISTENCE.md
# SESSION_STORE=memory
# SESSION_STORE=redis
# REDIS_URL=redis://10.1.1.15:6379

# ----- Logto -----
LOGTO_ENDPOINT=https://auth.junhai.work
LOGTO_APP_ID=your_app_id
LOGTO_APP_SECRET=your_app_secret
# 修改 Logto 密码（用户信息页）需 Management API；不填则沿用上面 APP_ID/APP_SECRET
# LOGTO_M2M_APP_ID=
# LOGTO_M2M_APP_SECRET=
