# ============ apps/web 环境变量示例 ============
# 复制为 .env 后按实际修改。与根目录 .env.example 中的 Logto 等可共用同一套值。

# ---------- 开发时 /api 代理（webpack devServer 读取）----------
# 中间层地址；未设置时默认 http://localhost:3000。修改后需重启 pnpm run dev
WEBPACK_PROXY_TARGET=http://localhost:3000

# ---------- Logto 登录（中间层未启动时的降级，构建时注入）----------
# 仅在前端单独运行且请求不到 /api/auth/logto/config 时使用；与根目录 LOGTO_* 保持一致即可
# 设置后需重新执行 pnpm run dev 或 pnpm run build。回调换 token 仍依赖中间层
# LOGTO_ENDPOINT=https://your-tenant.logto.app
# LOGTO_APP_ID=your-app-id
# APP_ORIGIN=   # 可选，不设则用当前页 origin（如 http://localhost:3001）
